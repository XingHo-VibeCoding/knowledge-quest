# ============================================================
# knowledge-quest 环境变量样例（Day 23 新增）
#
# 用法：把本文件复制成 .env，再把下面各项填成你自己的值。
#       .env 已被 .gitignore 忽略（`git check-ignore -v .env` 可复核），永不入库。
#       本文件**只写字段名与说明**——任何真实值都不许出现在这里。
#
# 两个地方要同一套变量名（值可以不同）：
#   ① 本地调试：.env（本文件复制而来）
#   ② 线上云函数：部署时注入（见 cloudbase/deploy.sh 与 docs/day17-checkin.md）
# ============================================================

# CloudBase 环境 ID，形如 abc123xyz-1a2b3c4d5e6f7a8b
# 不是密钥（前端也会带这个值），但属于「配置」，同样不写死在代码里
CLOUDBASE_ENV_ID=

# 网关地址：https://<上面的环境ID>.api.tcloudbasegateway.com
# 留空时由代码按 CLOUDBASE_ENV_ID 自动拼出来
CLOUDBASE_GATEWAY=

# ⚠️ 真正的密钥：CloudBase 环境 API Key（service_role，服务端专用）
# 它等同于数据库的最高权限，只允许出现在两处：
#   ① 本机 .env（不进 Git、不发群、不进截图）
#   ② 云函数环境变量（部署时注入）
# 前端页面里永远不该有它；一旦怀疑泄露，去控制台作废并重新生成。
CLOUDBASE_API_KEY=

# ---------- 可选（本地调试用，不填走默认值）----------

# 本地 HTTP 服务端口（cloudbase/local-http.js 用），默认 8790
PORT=8790

# 本地回归测试时置 1：云函数不打印 [KQ] 请求日志，避免淹没断言输出
KQ_QUIET=0
